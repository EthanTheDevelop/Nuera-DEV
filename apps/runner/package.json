    "@xterm/headless": "6.0.0",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.8",
    "pidusage": "4.1.0",
    "pino": "10.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pidusage": "2.0.5",
    "esbuild": "0.28.2",
    "pino-pretty": "13.2.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
