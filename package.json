{
  "name": "nuera-dev",
  "private": true,
  "version": "0.1.0",
  "description": "Nuera Dev — espace de développement personnel : projets GitHub clonés sur le VPS, sessions Claude Code, Git intégré.",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @nuera/web --filter @nuera/runner dev",
    "build": "pnpm --filter @nuera/web --filter @nuera/runner build",
    "start": "pnpm --parallel --filter @nuera/web --filter @nuera/runner start",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "e2e": "pnpm --filter @nuera/web e2e",
    "db:local": "node scripts/dev-db.mjs",
    "db:generate": "pnpm --filter @nuera/db generate",
    "db:migrate": "pnpm --filter @nuera/db migrate",
    "db:studio": "pnpm --filter @nuera/db studio",
    "setup:env": "node scripts/setup-env.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "embedded-postgres": "17.11.0-beta.19",
    "eslint": "9.39.5",
    "globals": "17.14.0",
    "postgres": "3.4.9",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
