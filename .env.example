# =============================================================================
# Nuera Dev — variables d'environnement
# Copier vers .env (dev) : `pnpm setup:env` génère les secrets aléatoires.
# En production (Coolify), renseigner ces variables dans chaque service.
# Ne jamais versionner de vraie valeur.
# =============================================================================

# --- Commun -------------------------------------------------------------------
# PostgreSQL (dev : `pnpm db:local`). En prod : ressource PostgreSQL Coolify, non exposée.
DATABASE_URL=postgres://nuera:nuera@127.0.0.1:54329/nuera_dev

# URL publique de l'application (sert aux cookies, à l'Origin/CSRF, aux callbacks GitHub).
APP_URL=http://localhost:3000

# Runner : URL privée et jeton partagé web ⇄ runner (32+ octets aléatoires).
RUNNER_URL=http://127.0.0.1:4100
RUNNER_TOKEN=

# --- Web (apps/web) -----------------------------------------------------------
# Secret Better Auth (32+ octets aléatoires).
BETTER_AUTH_SECRET=
# Clé de chiffrement des secrets applicatifs (AES-256-GCM) : 32 octets en base64.
APP_ENCRYPTION_KEY=
# Jeton à usage unique exigé pour créer le compte propriétaire (page /configuration).
SETUP_TOKEN=
# Web Push (notifications téléphone) — `npx web-push generate-vapid-keys`.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact des services push : mailto:<adresse> ou URL https (vide = APP_URL si elle est en https).
VAPID_SUBJECT=
# API GitHub (laisser vide pour https://api.github.com ; surcharge réservée aux tests).
GITHUB_API_URL=
# Repli documenté, non proposé dans l'interface : PAT à granularité fine.
GITHUB_FALLBACK_TOKEN=

# --- Runner (apps/runner) -----------------------------------------------------
# Écoute privée du runner (jamais exposée sur Internet).
RUNNER_HOST=127.0.0.1
RUNNER_PORT=4100
# Écoute locale réservée aux hooks / status line du CLI Claude (127.0.0.1 uniquement).
RUNNER_HOOK_PORT=4101
# Racine des clones et worktrees (prod : /srv/dev).
NUERA_PROJECTS_ROOT=./.data/projects
# Données d'exécution du runner : réglages de session, journaux (prod : /data).
NUERA_DATA_DIR=./.data/runner
# Backend des sessions : tmux (prod Linux) | pty (dev Windows, sans tmux). Vide = détection automatique.
NUERA_SESSION_BACKEND=
# Binaire Claude Code officiel (vide = `claude` dans le PATH). Les tests utilisent un faux CLI.
NUERA_CLAUDE_BIN=
# Niveau de journalisation : info | debug | warn
LOG_LEVEL=info

# --- Optionnel ----------------------------------------------------------------
# Base : taille du pool (web, défaut 5) et délai de connexion en secondes (défaut 30).
# DATABASE_POOL_MAX=5
# DATABASE_CONNECT_TIMEOUT=30
# Rotation de la clé de chiffrement : identifiant de la clé courante (défaut v1) et anciennes clés
# encore acceptées en lecture ("v0:<base64>,v-1:<base64>") — voir docs/SECURITY.md.
# APP_ENCRYPTION_KEY_ID=v1
# APP_ENCRYPTION_PREVIOUS_KEYS=
# En-tête d'adresse IP fixé par le proxy inverse (Traefik/Coolify : x-real-ip, valeur par défaut).
# TRUSTED_IP_HEADER=x-real-ip
# En-tête de ville fourni par un CDN de confiance uniquement (ex. cf-ipcity) ; sinon aucune ville.
# TRUSTED_CITY_HEADER=
# Page d'état de l'hébergeur (https), proposée quand le serveur est injoignable (T5).
# NUERA_SERVER_STATUS_URL=
# Version affichée par /api/health (défaut : version du paquet).
# NUERA_VERSION=
# Runner → web : URL interne des rappels /api/internal/* (défaut APP_URL ; compose : http://web:3000).
# NUERA_WEB_INTERNAL_URL=
# Tâches périodiques du runner (vérification des intégrations, fetch, disponibilité) : 0 = désactivées.
# NUERA_SCHEDULER=1

# --- Développement et tests uniquement (ignorés ou interdits en production) ---
# Galerie /kit sans session (next dev uniquement).
# NUERA_KIT_PUBLIC=1
# Multiplicateur des limites de débit de l'authentification (e2e ; ignoré en production).
# NUERA_RATE_LIMIT_FACTOR=1
# Faux GitHub des tests : pages de redirection navigateur et base des dépôts distants (file:///…/).
# GITHUB_WEB_URL=
# NUERA_GIT_REMOTE_BASE=
# Playwright : port du serveur testé, base dédiée (recréée à chaque passage), serveur PostgreSQL.
# E2E_PORT=3102
# E2E_DATABASE=nuera_e2e
# E2E_PG_URL=postgres://nuera:nuera@127.0.0.1:54329

